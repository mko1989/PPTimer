<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PowerPoint COM add-in (same loading mechanism VSTO uses underneath, minus the VSTO runtime),
    so it builds with the plain .NET SDK on macOS or Windows:  dotnet build -c Release
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>PPTimer</AssemblyName>
    <RootNamespace>PPTimer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Version>1.0.3</Version>
    <!-- Kept fixed: install.ps1 writes it into the COM registration. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.3.0</FileVersion>
    <DebugType>full</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets non-Windows machines compile against .NET Framework. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Core/*.html" LogicalName="PPTimer.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
