<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PPTimer.exe: a notification area app that draws the countdown over PowerPoint's presenter view or a screen.
    .NET Framework 4.8 (part of Windows 10/11, nothing to install). Builds with the plain .NET SDK on macOS or
    Windows:  dotnet build -c Release
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>PPTimer</AssemblyName>
    <RootNamespace>PPTimer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>1.1.0</Version>
    <DebugType>full</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets non-Windows machines compile against .NET Framework. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Left over from the PowerPoint add-in (1.0.x); PPTimer is a standalone app since 1.1.0. Safe to delete. -->
    <Compile Remove="Windows/Connect.cs;Windows/IDTExtensibility2.cs;Windows/AddinHost.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Core/*.html" LogicalName="PPTimer.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
